{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FM Player Sorter",
  "version": "0.2.0",
  "identifier": "pl.fmplayersorter.desktop",
  "build": {
"frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
  "title": "FM Player Sorter",
  "width": 1600,
  "height": 1000,
  "minWidth": 1100,
  "minHeight": 700,
  "resizable": true,
  "fullscreen": false,
  "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwOTU5MTE4REM2QzgwODkKUldTSmdHemNHSkdWZ0ZsZzFQMUdvdUhmcWNOd2UwRzQ5S3VHb3hqL3V2ZU1HbGV1Mm9UTEFJbXMK",
      "endpoints": [
        "https://github.com/matreju/fm-player-sorter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
